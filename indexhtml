<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cronograma de Proveedores Aruma</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
:root{
  --ink:#241C22; --ink-soft:#40323A; --paper:#FFFFFF; --card:#FFFFFF;
  --line:#F1DCE3; --line-soft:#FAEFF2; --text:#241C22; --muted:#8C7680;
  --pink:#FA0082; --pink-dark:#C9006A; --blush:#FFE1E6; --blush-soft:#FFF3F6;
  --lilac:#8382F7; --lilac-weak:#ECECFE; --orange:#FF9A00; --orange-weak:#FFF3DE;
  --rail:64px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--paper); color:var(--text);
  font-family:"IBM Plex Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:14px; line-height:1.5; font-variant-numeric:tabular-nums;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,.num{font-family:"Plus Jakarta Sans","IBM Plex Sans",sans-serif;font-weight:700;letter-spacing:-.01em}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--pink);outline-offset:2px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* ---------- rail ---------- */
.rail{position:fixed;left:0;top:0;bottom:0;width:var(--rail);background:var(--ink);
  display:flex;flex-direction:column;align-items:center;gap:4px;padding:14px 0;z-index:40}
.rail .mark{width:32px;height:32px;border-radius:8px;background:var(--pink);color:#fff;
  display:grid;place-items:center;font-family:"Plus Jakarta Sans";font-weight:800;font-size:15px;margin-bottom:14px}
.rail button{width:44px;height:44px;border:0;background:transparent;color:#B79AA6;border-radius:8px;
  display:grid;place-items:center;position:relative}
.rail button:hover{background:#3A2C33;color:#fff}
.rail button[aria-current="true"]{color:#fff;background:#3A2C33}
.rail button[aria-current="true"]::before{content:"";position:absolute;left:-14px;top:10px;bottom:10px;width:3px;background:var(--pink);border-radius:0 2px 2px 0}
.rail svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.rail .tip{position:absolute;left:52px;background:var(--ink);color:#fff;padding:4px 9px;border-radius:6px;
  font-size:12px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s;z-index:50}
.rail button:hover .tip{opacity:1}

/* ---------- shell ---------- */
.shell{margin-left:var(--rail);max-width:1500px;padding:0 26px 80px}
.topbar{position:sticky;top:0;z-index:30;background:rgba(255,255,255,.94);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--line);margin:0 -26px 22px;padding:14px 26px;
  display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.topbar h1{font-size:18px;margin:0}
.topbar .sub{color:var(--muted);font-size:12.5px}
.range-chip{margin-left:auto;display:flex;align-items:center;gap:8px;background:var(--blush);
  border:1px solid #F6C6D4;border-left:3px solid var(--pink);padding:6px 12px;border-radius:6px;font-size:13px}
.range-chip b{font-family:"Plus Jakarta Sans"}
.btn{border:1px solid var(--line);background:var(--card);padding:7px 13px;border-radius:8px;font-size:13px;font-weight:600}
.btn:hover{border-color:var(--pink);color:var(--pink)}
.btn-solid{background:var(--pink);border-color:var(--pink);color:#fff}
.btn-solid:hover{background:var(--pink-dark);border-color:var(--pink-dark);color:#fff}
.btn-ghost{border-color:transparent;background:transparent;color:var(--muted)}
.btn-ghost:hover{color:var(--pink)}
.btn:disabled{opacity:.45;cursor:not-allowed}

section{margin-bottom:34px;scroll-margin-top:78px}
.sec-head{display:flex;align-items:baseline;gap:12px;border-bottom:1px solid var(--line);padding-bottom:7px;margin-bottom:16px}
.sec-head h2{font-size:15px;margin:0}
.sec-head .hint{color:var(--muted);font-size:12.5px}
.sec-head .right{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}

/* ---------- carga ---------- */
.drop{border:1.5px dashed #F0C3D2;background:var(--blush-soft);padding:34px 24px;text-align:center;border-radius:12px}
.drop.over{border-color:var(--pink);background:var(--blush)}
.drop p{margin:6px 0 0;color:var(--muted);font-size:13px}
.drop strong{font-family:"Plus Jakarta Sans";font-size:15px}
.prog{height:5px;background:var(--line-soft);margin-top:14px;display:none;border-radius:3px;overflow:hidden}
.prog.on{display:block}
.prog i{display:block;height:100%;background:var(--pink);width:0;transition:width .15s}
.filelist{margin-top:14px;border:1px solid var(--line);background:var(--card);border-radius:12px;overflow:hidden}
.filerow{display:flex;align-items:center;gap:12px;padding:9px 13px;border-bottom:1px solid var(--line-soft);font-size:13px;flex-wrap:wrap}
.filerow:last-child{border-bottom:0}
.filerow .nm{font-weight:600;flex:1;min-width:180px;word-break:break-all}
.filerow .meta{color:var(--muted);font-size:12.5px}
.tag{font-size:11.5px;padding:2px 8px;border-radius:999px;border:1px solid var(--line);font-weight:600}
.tag.ok{background:var(--blush);border-color:#F6C6D4;color:var(--pink-dark)}
.tag.work{background:var(--orange-weak);border-color:#F3DBA8;color:#8A5B06}
.tag.err{background:#FBE9E7;border-color:#F0C8C2;color:#8C2F22}
.filerow select{border:1px solid var(--line);border-radius:6px;padding:3px 6px;font-size:12.5px;background:#fff}
.x{border:0;background:transparent;color:var(--muted);font-size:17px;line-height:1;padding:2px 6px}
.x:hover{color:var(--pink)}

/* ---------- controles ---------- */
.grid-ctl{display:grid;grid-template-columns:repeat(auto-fit,minmax(215px,1fr));gap:12px}
.field{background:var(--card);border:1px solid var(--line);padding:10px 12px;border-radius:10px}
.field label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:600}
.field select,.field input{width:100%;border:1px solid var(--line);border-radius:8px;padding:6px 8px;background:#fff}
.presets{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.presets button{border:1px solid var(--line);background:var(--card);padding:5px 12px;border-radius:999px;font-size:12.5px;font-weight:600}
.presets button:hover{border-color:var(--pink);color:var(--pink)}
.presets button[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}

/* ---------- multiselect proveedor/detalle ---------- */
.msel-wrap{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;margin-top:14px}
.msel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
.msel-head{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.msel-head strong{font-size:13.5px}
.msel-count{margin-left:auto;font-size:11.5px;color:var(--pink-dark);background:var(--blush);padding:2px 9px;border-radius:999px;font-weight:700;white-space:nowrap}
.msel input[type=search]{width:100%;border:1px solid var(--line);border-radius:8px;padding:6px 9px;margin-bottom:8px;background:#fff}
.msel-actions{display:flex;gap:8px;margin-bottom:9px}
.msel-actions button{border:1px solid var(--line);background:#fff;padding:4px 10px;border-radius:999px;font-size:11.5px;font-weight:600}
.msel-actions button:hover{border-color:var(--pink);color:var(--pink)}
.msel-list{max-height:230px;overflow-y:auto;border-top:1px solid var(--line-soft)}
.msel-item{display:flex;align-items:center;gap:8px;padding:6px 4px;font-size:12.8px;border-bottom:1px solid var(--line-soft)}
.msel-item:hover{background:var(--blush-soft)}
.msel-item input{accent-color:var(--pink)}
.msel-item span.nm{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.msel-item span.ct{color:var(--muted);font-size:11px}
.msel-empty{padding:14px 4px;color:var(--muted);font-size:12.5px;text-align:center}
.msel-warn{margin-top:8px;font-size:11.5px;color:#8A5B06;background:var(--orange-weak);border:1px solid #F3DBA8;border-radius:8px;padding:6px 9px}
.msel-missing{background:var(--card);border:1px dashed var(--line);border-radius:12px;padding:16px;color:var(--muted);font-size:12.8px}

/* ---------- kpis ---------- */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.kpi{background:var(--card);padding:14px 16px;border-left:3px solid transparent}
.kpi:hover{border-left-color:var(--pink)}
.kpi .k{font-size:12px;color:var(--muted);margin-bottom:6px;font-weight:600}
.kpi .v{font-family:"Plus Jakarta Sans";font-size:26px;font-weight:800;letter-spacing:-.02em;line-height:1.1}
.kpi .d{font-size:12.5px;margin-top:6px;display:flex;align-items:center;gap:5px;color:var(--muted);flex-wrap:wrap}
.up{color:var(--pink);font-weight:700}
.down{color:var(--lilac);font-weight:700}
.flat{color:var(--muted);font-weight:700}

/* ---------- pivot proveedor x detalle ---------- */
.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px 16px}
.panel h3{font-size:13.5px;margin:0 0 2px}
.panel .ph{color:var(--muted);font-size:12px;margin:0 0 12px}
.pivot-tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.pivot-tools input[type=search]{border:1px solid var(--line);border-radius:8px;padding:6px 10px;min-width:220px;background:#fff}
table.pivot{border-collapse:separate;border-spacing:0;width:100%;font-size:13px}
table.pivot th{position:sticky;top:0;background:var(--blush-soft);border-bottom:1px solid var(--line);padding:9px 10px;text-align:left;cursor:pointer;white-space:nowrap;font-weight:700}
table.pivot th:hover{color:var(--pink)}
table.pivot td{padding:8px 10px;border-bottom:1px solid var(--line-soft)}
table.pivot td.n{text-align:right}
table.pivot tbody tr:hover td{background:var(--blush-soft)}
table.pivot tfoot td{font-weight:800;border-top:2px solid var(--line);background:var(--blush-soft)}
.pivot-scroll{max-height:460px;overflow:auto;border:1px solid var(--line);border-radius:12px}
.sortmark{color:var(--pink);font-size:10px;margin-left:3px}

/* ---------- tabla ---------- */
.tbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.tbar input[type=search]{border:1px solid var(--line);border-radius:8px;padding:6px 10px;min-width:220px;background:#fff}
.tbar select{border:1px solid var(--line);border-radius:8px;padding:6px 8px;background:#fff}
.tscroll{border:1px solid var(--line);background:var(--card);overflow:auto;max-height:620px;border-radius:12px}
table.data{border-collapse:separate;border-spacing:0;width:100%;font-size:12.8px}
table.data th{position:sticky;top:0;background:var(--blush-soft);border-bottom:1px solid var(--line);padding:0;z-index:2;text-align:left}
table.data th .thin{padding:8px 10px 4px;display:flex;align-items:center;gap:5px;cursor:pointer;white-space:nowrap;font-weight:700}
table.data th input{width:calc(100% - 14px);margin:0 7px 7px;border:1px solid var(--line);border-radius:6px;padding:3px 5px;font-size:11.5px;background:#fff}
table.data td{padding:6px 10px;border-bottom:1px solid var(--line-soft);white-space:nowrap;max-width:280px;overflow:hidden;text-overflow:ellipsis}
table.data tbody tr:hover td{background:var(--blush-soft)}
td.n{text-align:right}
.pager{display:flex;gap:8px;align-items:center;margin-top:10px;font-size:12.5px;color:var(--muted);flex-wrap:wrap}
.cols{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
.cols label{font-size:12px;border:1px solid var(--line);background:var(--card);padding:3px 9px;border-radius:999px;display:flex;gap:5px;align-items:center;cursor:pointer;font-weight:600}
.cols input{accent-color:var(--pink)}

.empty{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:40px 24px;text-align:center;color:var(--muted)}
.empty strong{display:block;font-family:"Plus Jakarta Sans";color:var(--text);font-size:16px;margin-bottom:6px}
.hidden{display:none!important}
.note{font-size:12.5px;color:var(--muted)}
.toast{position:fixed;right:18px;bottom:18px;background:var(--ink);color:#fff;padding:10px 15px;border-radius:10px;font-size:13px;z-index:90;max-width:340px}

@media print{
  .rail,.topbar .btn,.drop,.filelist,#sec-carga,#sec-config,.tbar,.cols,.pager,.presets,
  .msel input[type=search],.msel-actions,.msel-list{display:none!important}
  .shell{margin:0;max-width:none;padding:0}
  .panel,.kpis,.tscroll,.pivot-scroll{break-inside:avoid;border-color:#ccc}
  .tscroll,.pivot-scroll{max-height:none}
  body{background:#fff}
}
@media (max-width:640px){
  .shell{padding:0 14px 60px}
  .topbar{margin:0 -14px 18px;padding:12px 14px}
  .range-chip{margin-left:0;width:100%}
  .kpi .v{font-size:22px}
}
</style>
</head>
<body>

<nav class="rail" aria-label="Secciones">
  <div class="mark">A</div>
  <button data-go="sec-carga" aria-current="true"><svg viewBox="0 0 24 24"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2"/></svg><span class="tip">Archivos</span></button>
  <button data-go="sec-config"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15 1.65 1.65 0 0 0 3.16 14H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06A2 2 0 1 1 7.04 4.3l.06.06A1.65 1.65 0 0 0 8.92 4.7 1.65 1.65 0 0 0 10 3.16V3a2 2 0 0 1 4 0v.09c0 .68.39 1.29 1 1.51a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.3 9c.22.61.83 1 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span class="tip">Configuración</span></button>
  <button data-go="sec-filtros"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg><span class="tip">Filtros</span></button>
  <button data-go="sec-kpis"><svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-6M22 19H2"/></svg><span class="tip">Indicadores</span></button>
  <button data-go="sec-pivot"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10M15 10v10"/></svg><span class="tip">Proveedor × Detalle</span></button>
  <button data-go="sec-tabla"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/></svg><span class="tip">Datos</span></button>
  <button data-go="sec-reporte"><svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg><span class="tip">Reporte</span></button>
</nav>

<div class="shell">

  <div class="topbar">
    <div>
      <h1>Cronograma de Proveedores Aruma</h1>
      <div class="sub" id="sourceLine">Sin archivos cargados</div>
    </div>
    <div class="range-chip" id="rangeChip">Periodo: <b>todo el historial</b></div>
    <button class="btn btn-solid" id="btnReport" disabled>Generar reporte</button>
  </div>

  <!-- ============ CARGA ============ -->
  <section id="sec-carga">
    <div class="sec-head">
      <h2>Cargar archivos Excel</h2>
      <span class="hint">Formatos .xlsx, .xls, .xlsm, .csv — sin límite de cantidad</span>
      <span class="right"><button class="btn btn-ghost" id="btnClear">Quitar todos</button></span>
    </div>

    <div class="drop" id="drop">
      <strong>Arrastra tus archivos aquí</strong>
      <p>o <button class="btn" id="btnPick" style="margin:0 2px">elígelos desde tu equipo</button></p>
      <p style="margin-top:10px">Los archivos nuevos se suman a los ya cargados. Las columnas con el mismo nombre se combinan en una sola tabla.</p>
      <input type="file" id="picker" multiple accept=".xlsx,.xls,.xlsm,.csv" class="hidden">
      <div class="prog" id="prog"><i></i></div>
    </div>
    <div class="filelist hidden" id="filelist"></div>
  </section>

  <!-- ============ CONFIG ============ -->
  <section id="sec-config" class="hidden">
    <div class="sec-head">
      <h2>Configuración</h2>
      <span class="hint">Campos detectados automáticamente; puedes cambiarlos</span>
    </div>
    <div class="grid-ctl">
      <div class="field">
        <label for="selDate">Columna de fecha</label>
        <select id="selDate"></select>
      </div>
      <div class="field">
        <label for="selDayFirst">Lectura de fechas ambiguas</label>
        <select id="selDayFirst">
          <option value="1">Día primero (31/12/2026)</option>
          <option value="0">Mes primero (12/31/2026)</option>
        </select>
      </div>
      <div class="field">
        <label for="selProv">Columna de proveedor</label>
        <select id="selProv"></select>
      </div>
      <div class="field">
        <label for="selDet">Columna de detalle</label>
        <select id="selDet"></select>
      </div>
      <div class="field">
        <label for="selMetric">Métrica numérica (opcional)</label>
        <select id="selMetric"></select>
      </div>
      <div class="field">
        <label for="selAgg">Cómo resumir la métrica</label>
        <select id="selAgg">
          <option value="sum">Suma</option>
          <option value="avg">Promedio</option>
          <option value="count">Cantidad de registros</option>
        </select>
      </div>
    </div>
    <p class="note" id="colsNote" style="margin-top:10px"></p>
  </section>

  <!-- ============ FILTROS ============ -->
  <section id="sec-filtros" class="hidden">
    <div class="sec-head">
      <h2>Filtros</h2>
      <span class="hint">Periodo, proveedor y detalle — todo lo demás responde a esto</span>
      <span class="right"><button class="btn btn-ghost" id="btnAll">Ver todo el historial</button></span>
    </div>

    <div class="grid-ctl">
      <div class="field"><label for="dFrom">Fecha desde</label><input type="date" id="dFrom"></div>
      <div class="field"><label for="dTo">Fecha hasta</label><input type="date" id="dTo"></div>
      <div class="field">
        <label for="chkCmp">Comparación</label>
        <select id="chkCmp">
          <option value="1">Contra el periodo anterior equivalente</option>
          <option value="0">Sin comparación</option>
        </select>
      </div>
      <div class="field">
        <label>Cobertura de los datos</label>
        <div class="note" id="coverage">—</div>
      </div>
    </div>
    <div class="presets" id="presets">
      <button data-p="today">Hoy</button>
      <button data-p="yesterday">Ayer</button>
      <button data-p="7">Últimos 7 días</button>
      <button data-p="30">Últimos 30 días</button>
      <button data-p="tmonth">Este mes</button>
      <button data-p="lmonth">Mes anterior</button>
      <button data-p="tyear">Este año</button>
      <button data-p="lyear">Año anterior</button>
      <button data-p="all" aria-pressed="true">Todo</button>
    </div>

    <div class="msel-wrap">
      <div id="provBox"></div>
      <div id="detBox"></div>
    </div>
  </section>

  <!-- ============ KPIs ============ -->
  <section id="sec-kpis" class="hidden">
    <div class="sec-head">
      <h2>Indicadores del periodo</h2>
      <span class="hint" id="kpiHint"></span>
    </div>
    <div class="kpis" id="kpis"></div>
  </section>

  <!-- ============ PIVOT PROVEEDOR X DETALLE ============ -->
  <section id="sec-pivot" class="hidden">
    <div class="sec-head">
      <h2>Proveedor × Detalle</h2>
      <span class="hint" id="pivotHint">Registros y métrica por combinación, con todos los filtros aplicados</span>
    </div>
    <div class="panel">
      <div class="pivot-tools">
        <input type="search" id="pivotSearch" placeholder="Buscar proveedor o detalle">
      </div>
      <div class="pivot-scroll">
        <table class="pivot" id="pivotTable"><thead></thead><tbody></tbody><tfoot></tfoot></table>
      </div>
      <p class="msel-missing hidden" id="pivotMissing" style="margin-top:12px">
