<script>
/* =========================================================================
   Estado
   ========================================================================= */
const S = {
  files: [],          // {id,file,name,size,rows,status,sheets,sheet,data:[]}
  rows: [],           // filas combinadas
  cols: [],           // {key,label,type}
  dateKey:null, provKey:null, detKey:null, metricKey:null,
  dayFirst:true, agg:'sum',
  from:null, to:null, preset:'all', compare:true,
  dateIdx:[],
  provAll:[], detAll:[], provSelected:new Set(), detSelected:new Set(),
  provSearch:'', detSearch:'',
  filtered:[], page:1, pageSize:50, sortKey:null, sortDir:1,
  q:'', colFilters:{}, visible:{},
  pivotSearch:'', pivotSort:{key:'registros',dir:-1}
};
const $ = s=>document.querySelector(s);
const $$ = s=>Array.from(document.querySelectorAll(s));
const MES = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const SIN_DATO = '(sin dato)';

function toast(msg,ms=3200){
  const t=document.createElement('div'); t.className='toast'; t.textContent=msg;
  document.body.appendChild(t); setTimeout(()=>t.remove(),ms);
}
const fmtN = n => n===null||n===undefined||!isFinite(n) ? '—'
  : new Intl.NumberFormat('es-PE',{maximumFractionDigits: Math.abs(n)>=1000?0:2}).format(n);
const fmtInt = n => new Intl.NumberFormat('es-PE').format(n||0);
const fmtSize = b => b<1024?b+' B' : b<1048576?(b/1024).toFixed(0)+' KB' : (b/1048576).toFixed(1)+' MB';
function fmtDate(ms){ if(ms==null) return '—'; const d=new Date(ms);
  return String(d.getDate()).padStart(2,'0')+' '+MES[d.getMonth()]+' '+d.getFullYear(); }
function isoOf(ms){ const d=new Date(ms); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function dayStart(ms){ const d=new Date(ms); d.setHours(0,0,0,0); return d.getTime(); }
function dayEnd(ms){ const d=new Date(ms); d.setHours(23,59,59,999); return d.getTime(); }
function fromISO(v){ if(!v) return null; const [y,m,d]=v.split('-').map(Number); return new Date(y,m-1,d).getTime(); }
const valOf = v => (v===null||v===undefined||v==='') ? SIN_DATO : String(v);

/* =========================================================================
   Normalización de columnas y detección de tipos
   ========================================================================= */
const norm = s => String(s??'').trim().toLowerCase()
  .normalize('NFD').replace(/[\u0300-\u036f]/g,'')
  .replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');

const DATE_HINTS = ['fecha','fec','date','dia','día','periodo','emision','emisión','registro','operacion','operación','vencimiento','created','timestamp','mes'];
const PROV_HINTS = ['proveedor','proveedores','supplier','vendor','empresa','razon_social','razón_social','contratista'];
const DET_HINTS = ['detalle','descripcion','descripción','actividad','tarea','item','ítem','concepto','servicio','trabajo','entregable'];
const looksLike = (k,hints) => hints.some(h=>k.includes(norm(h)));
const isDateName = k => looksLike(k,DATE_HINTS);
const isProvName = k => looksLike(k,PROV_HINTS);
const isDetName = k => looksLike(k,DET_HINTS);

function parseNumber(v){
  if(typeof v==='number') return isFinite(v)?v:null;
  if(v==null) return null;
  let s=String(v).trim();
  if(!s) return null;
  s=s.replace(/[^\d,.\-+()eE]/g,'');
  if(!s||s==='-'||s==='.') return null;
  let neg=/^\(.*\)$/.test(s); if(neg) s=s.slice(1,-1);
  const lc=s.lastIndexOf(','), ld=s.lastIndexOf('.');
  if(lc>-1&&ld>-1){ if(lc>ld){ s=s.replace(/\./g,'').replace(',','.'); } else { s=s.replace(/,/g,''); } }
  else if(lc>-1){ const dec=s.length-lc-1; s = (dec===3 && /^\d{1,3}(,\d{3})+$/.test(s)) ? s.replace(/,/g,'') : s.replace(',','.'); }
  const n=parseFloat(s);
  if(!isFinite(n)) return null;
  return neg?-n:n;
}

function excelSerialToMs(n){
  if(n<1||n>2958465) return null;
  const ms = Math.round((n-25569)*86400*1000);
  const d = new Date(ms);
  return new Date(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate(),d.getUTCHours(),d.getUTCMinutes(),d.getUTCSeconds()).getTime();
}

function parseDate(v,dayFirst){
  if(v==null||v==='') return null;
  if(v instanceof Date) return isNaN(v)?null:v.getTime();
  if(typeof v==='number') return excelSerialToMs(v);
  const s=String(v).trim();
  if(!s) return null;
  let m;
  m=s.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
  if(m) return new Date(+m[1],+m[2]-1,+m[3],+(m[4]||0),+(m[5]||0),+(m[6]||0)).getTime();
  m=s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{2,4})(?:[ T](\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
  if(m){
    let a=+m[1], b=+m[2], y=+m[3];
    if(y<100) y+= y<70?2000:1900;
    let d,mo;
    if(a>12){ d=a; mo=b; } else if(b>12){ d=b; mo=a; } else if(dayFirst){ d=a; mo=b; } else { d=b; mo=a; }
    if(mo<1||mo>12||d<1||d>31) return null;
    return new Date(y,mo-1,d,+(m[4]||0),+(m[5]||0),+(m[6]||0)).getTime();
  }
  const t=Date.parse(s);
  return isNaN(t)?null:t;
}

function detectType(key,samples,dayFirst){
  const vals=samples.filter(v=>v!==null&&v!==undefined&&v!=='');
  if(!vals.length) return 'text';
  const dates=vals.filter(v=>v instanceof Date).length;
  if(dates/vals.length>0.6) return 'date';
  const nums=vals.filter(v=>parseNumber(v)!==null).length;
  const parsed=vals.filter(v=>parseDate(v,dayFirst)!==null).length;
  const strDates=vals.filter(v=>typeof v==='string'&&/\d{1,4}[-\/.]\d{1,2}[-\/.]\d{1,4}/.test(v)).length;
  if(strDates/vals.length>0.6) return 'date';
  if(isDateName(key)&&parsed/vals.length>0.7&&nums/vals.length<0.9) return 'date';
  if(nums/vals.length>0.85) return 'number';
  return 'text';
}

function findHeaderRow(matrix){
  const lim=Math.min(matrix.length,25);
  let best=0,bestScore=-1;
  for(let i=0;i<lim;i++){
    const r=matrix[i]||[];
    const cells=r.filter(c=>c!==null&&c!==undefined&&String(c).trim()!=='');
    if(cells.length<2) continue;
    const texts=cells.filter(c=>typeof c==='string'&&isNaN(Number(c))).length;
    const width=Math.max(...matrix.slice(0,lim).map(x=>x.length),1);
    const score=(cells.length/width)*1.2 + (texts/cells.length);
    if(score>bestScore){ bestScore=score; best=i; }
    if(cells.length/width>0.7 && texts/cells.length>0.7) return i;
  }
  return best;
}

function sheetToRows(ws){
  const matrix = XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:null,blankrows:false});
  if(!matrix.length) return {headers:[],rows:[]};
  const h = findHeaderRow(matrix);
  const raw = matrix[h]||[];
  const headers=[], seen={};
  const width = Math.max(...matrix.map(r=>r.length));
  for(let i=0;i<width;i++){
    let label = raw[i]!=null && String(raw[i]).trim()!=='' ? String(raw[i]).trim().replace(/\s+/g,' ') : 'Columna '+(i+1);
    let key = norm(label) || 'col_'+(i+1);
    if(seen[key]!==undefined){ seen[key]++; key=key+'_'+seen[key]; label=label+' ('+seen[key]+')'; } else seen[key]=1;
    headers.push({key,label,i});
  }
  const rows=[];
  for(let r=h+1;r<matrix.length;r++){
    const arr=matrix[r]; if(!arr) continue;
    let empty=true; const o={};
    for(const hd of headers){
      let v=arr[hd.i];
      if(v===''||v===undefined) v=null;
      if(typeof v==='string'){ v=v.trim(); if(v==='') v=null; if(v&&/^#(N\/A|REF!|VALUE!|DIV\/0!|NAME\?|NULL!)/i.test(v)) v=null; }
      if(v!==null) empty=false;
      o[hd.key]=v;
    }
    if(!empty) rows.push(o);
  }
  return {headers,rows};
}

/* =========================================================================
   Carga de archivos
   ========================================================================= */
let uid=0;
const drop=$('#drop'), picker=$('#picker');
$('#btnPick').onclick=()=>picker.click();
picker.onchange=e=>{ addFiles(Array.from(e.target.files)); picker.value=''; };
['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('over');}));
['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('over');}));
drop.addEventListener('drop',e=>{
  const fs=Array.from(e.dataTransfer.files).filter(f=>/\.(xlsx|xls|xlsm|csv)$/i.test(f.name));
  if(!fs.length) return toast('Ese tipo de archivo no se puede leer. Usa .xlsx, .xls, .xlsm o .csv.');
  addFiles(fs);
});

const yieldUI = ()=>new Promise(r=>setTimeout(r,0));

async function addFiles(list){
  if(!list.length) return;
  const entries=list.map(f=>({id:++uid,file:f,name:f.name,size:f.size,rows:0,status:'pendiente',sheets:[],sheet:null,data:[]}));
  S.files.push(...entries);
  renderFiles();
  $('#prog').classList.add('on');
  for(let i=0;i<entries.length;i++){
    const e=entries[i];
    e.status='leyendo'; renderFiles();
    $('#prog').firstElementChild.style.width = ((i)/entries.length*100).toFixed(0)+'%';
    await yieldUI();
    try{ await readFile(e); e.status='listo'; }
    catch(err){ console.error(err); e.status='error'; e.error=err.message; }
    renderFiles(); await yieldUI();
  }
  $('#prog').firstElementChild.style.width='100%';
  setTimeout(()=>{ $('#prog').classList.remove('on'); $('#prog').firstElementChild.style.width='0'; },420);
  rebuild(true);
}

function readFile(entry){
  return new Promise((resolve,reject)=>{
    const fr=new FileReader();
    fr.onerror=()=>reject(new Error('No se pudo leer el archivo'));
    fr.onload=()=>{
      try{
        const wb=XLSX.read(fr.result,{type:'array',cellDates:true,dense:false});
        entry.sheets=wb.SheetNames.slice();
        if(!entry.sheet||!entry.sheets.includes(entry.sheet)) entry.sheet=pickSheet(wb);
        const out=sheetToRows(wb.Sheets[entry.sheet]);
        entry.data=out.rows.map(r=>{ r.__src=entry.name; return r; });
        entry.headers=out.headers;
        entry.rows=out.rows.length;
        resolve();
      }catch(err){ reject(err); }
    };
    fr.readAsArrayBuffer(entry.file);
  });
}
function pickSheet(wb){
  let best=wb.SheetNames[0],bestC=-1;
  for(const n of wb.SheetNames){
    const ref=wb.Sheets[n]['!ref']; if(!ref) continue;
    const r=XLSX.utils.decode_range(ref);
    const cells=(r.e.r-r.s.r+1)*(r.e.c-r.s.c+1);
    if(cells>bestC){ bestC=cells; best=n; }
  }
  return best;
}

async function changeSheet(id,sheet){
  const e=S.files.find(f=>f.id===id); if(!e) return;
  e.sheet=sheet; e.status='leyendo'; renderFiles(); await yieldUI();
  try{ await readFile(e); e.status='listo'; }catch(err){ e.status='error'; }
  renderFiles(); rebuild(true);
}

function renderFiles(){
  const box=$('#filelist');
  box.classList.toggle('hidden',!S.files.length);
  box.innerHTML=S.files.map(f=>{
    const tag = f.status==='listo'?'<span class="tag ok">listo</span>'
      : f.status==='error'?'<span class="tag err">no se pudo leer</span>'
      : '<span class="tag work">'+f.status+'</span>';
    const sheetSel = f.sheets.length>1
      ? '<select data-sheet="'+f.id+'" title="Hoja del archivo">'+f.sheets.map(s=>'<option'+(s===f.sheet?' selected':'')+'>'+esc(s)+'</option>').join('')+'</select>'
      : (f.sheet?'<span class="meta">hoja: '+esc(f.sheet)+'</span>':'');
    return '<div class="filerow"><span class="nm">'+esc(f.name)+'</span>'
      + sheetSel
      + '<span class="meta">'+fmtSize(f.size)+'</span>'
      + '<span class="meta">'+fmtInt(f.rows)+' registros</span>'
      + tag
      + '<button class="x" data-del="'+f.id+'" aria-label="Quitar archivo">×</button></div>';
  }).join('');
  box.querySelectorAll('[data-del]').forEach(b=>b.onclick=()=>{
    S.files=S.files.filter(f=>f.id!=b.dataset.del); renderFiles(); rebuild(true);
  });
  box.querySelectorAll('[data-sheet]').forEach(s=>s.onchange=()=>changeSheet(+s.dataset.sheet,s.value));
  const ok=S.files.filter(f=>f.status==='listo');
  $('#sourceLine').textContent = ok.length
    ? ok.length+' archivo'+(ok.length>1?'s':'')+' · '+fmtInt(ok.reduce((a,b)=>a+b.rows,0))+' registros combinados'
    : 'Sin archivos cargados';
}
$('#btnClear').onclick=()=>{ S.files=[]; renderFiles(); rebuild(true); };
const esc = s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

/* =========================================================================
   Combinar, tipar y preparar
   ========================================================================= */
function rebuild(resetFields){
  const ok=S.files.filter(f=>f.status==='listo');
  S.rows = ok.flatMap(f=>f.data);
  const hasData = S.rows.length>0;
  $('#emptyState').classList.toggle('hidden',hasData);
  ['sec-config','sec-filtros','sec-kpis','sec-pivot','sec-tabla','sec-reporte']
    .forEach(id=>$('#'+id).classList.toggle('hidden',!hasData));
  $('#btnReport').disabled=!hasData;
  if(!hasData){ S.cols=[]; $('#rangeChip').innerHTML='Periodo: <b>todo el historial</b>'; return; }

  const labels={};
  ok.forEach(f=>(f.headers||[]).forEach(h=>{ if(!labels[h.key]) labels[h.key]=h.label; }));
  const keys=Object.keys(labels);
  const step=Math.max(1,Math.floor(S.rows.length/400));
  S.cols=keys.map(k=>{
    const samples=[]; for(let i=0;i<S.rows.length&&samples.length<400;i+=step) samples.push(S.rows[i][k]);
    return {key:k,label:labels[k],type:detectType(k,samples,S.dayFirst)};
  });
  if(ok.length>1) S.cols.push({key:'__src',label:'Archivo de origen',type:'text'});

  if(resetFields||!S.cols.some(c=>c.key===S.dateKey)) autoFields();
  fillSelectors();
  buildDateIndex();
  if(resetFields||S.preset==='all') applyPreset('all',false);
  Object.keys(S.visible).length===0 && S.cols.forEach(c=>S.visible[c.key]=true);
  S.cols.forEach(c=>{ if(S.visible[c.key]===undefined) S.visible[c.key]=true; });
  renderColToggles();
  refreshProvDet();
  refresh();
}

function bestCategoryColumn(exclude){
  let best=null,bestScore=-1;
  for(const c of S.cols){
    if(c.type!=='text'||c.key==='__src'||exclude.includes(c.key)) continue;
    const set=new Set(); for(let i=0;i<S.rows.length&&set.size<200;i++){ const v=S.rows[i][c.key]; if(v!=null) set.add(String(v)); }
    const n=set.size, score = n>1&&n<=200 ? 100-n*0.2 : (n>200? -n/1000 : -1);
    if(score>bestScore){ bestScore=score; best=c.key; }
  }
  return best;
}

function autoFields(){
  const dates=S.cols.filter(c=>c.type==='date');
  const named=dates.find(c=>isDateName(c.key));
  S.dateKey=(named||dates[0]||{}).key||null;

  const nums=S.cols.filter(c=>c.type==='number');
  const preferred=nums.find(c=>/(importe|monto|total|valor|precio|cantidad|unidades|subtotal|costo)/.test(c.key));
  S.metricKey=(preferred||nums[0]||{}).key||null;

  const provNamed=S.cols.find(c=>c.type==='text'&&c.key!=='__src'&&isProvName(c.key));
  S.provKey = provNamed ? provNamed.key : bestCategoryColumn([]);

  const detNamed=S.cols.find(c=>c.type==='text'&&c.key!=='__src'&&c.key!==S.provKey&&isDetName(c.key));
  S.detKey = detNamed ? detNamed.key : bestCategoryColumn([S.provKey].filter(Boolean));
}

function fillSelectors(){
  const dates=S.cols.filter(c=>c.type==='date');
  const nums=S.cols.filter(c=>c.type==='number');
  const texts=S.cols.filter(c=>c.type==='text');
  const opt=(list,sel,extra)=>(extra?extra:[]).concat(list.map(c=>({v:c.key,l:c.label})))
    .map(o=>'<option value="'+o.v+'"'+(o.v===(sel||'')?' selected':'')+'>'+esc(o.l)+'</option>').join('');

  $('#selDate').innerHTML = dates.length?opt(dates,S.dateKey):'<option value="">Sin columnas de fecha detectadas</option>';
  $('#selProv').innerHTML = opt(texts,S.provKey,[{v:'',l:'Sin columna de proveedor'}]);
  $('#selDet').innerHTML = opt(texts,S.detKey,[{v:'',l:'Sin columna de detalle'}]);
  $('#selMetric').innerHTML = opt(nums,S.metricKey,[{v:'',l:'Sólo contar registros'}]);
  $('#selDayFirst').value=S.dayFirst?'1':'0';
  $('#selAgg').value=S.agg; $('#chkCmp').value=S.compare?'1':'0';

  $('#colsNote').textContent = S.cols.length+' columnas detectadas · '
    + dates.length+' de fecha, '+nums.length+' numéricas, '+texts.length+' de texto.'
    + (dates.length===0?' Sin fecha no hay filtro temporal.':'')
    + (!S.provKey?' No se detectó proveedor: elígelo aquí para activar ese filtro.':'')
    + (!S.detKey?' No se detectó detalle: elígelo aquí para activar ese filtro.':'');
}

function buildDateIndex(){
  const k=S.dateKey;
  if(!k){ S.dateIdx=new Array(S.rows.length).fill(null); $('#coverage').textContent='Sin columna de fecha'; return; }
  const idx=new Array(S.rows.length);
  let min=Infinity,max=-Infinity,valid=0;
  for(let i=0;i<S.rows.length;i++){
    const t=parseDate(S.rows[i][k],S.dayFirst);
    idx[i]=t;
    if(t!=null){ valid++; if(t<min)min=t; if(t>max)max=t; }
  }
  S.dateIdx=idx; S.min=valid?min:null; S.max=valid?max:null;
  $('#coverage').textContent = valid
    ? fmtDate(min)+' a '+fmtDate(max)+' · '+fmtInt(valid)+' fechas válidas'+(valid<S.rows.length?' ('+fmtInt(S.rows.length-valid)+' sin fecha)':'')
    : 'Ninguna fecha pudo interpretarse en esta columna';
}

/* selectores de configuración */
$('#selDate').onchange=e=>{ S.dateKey=e.target.value||null; buildDateIndex(); applyPreset(S.preset,false); refresh(); };
$('#selProv').onchange=e=>{ S.provKey=e.target.value||null; refreshProvDet(); refresh(); };
$('#selDet').onchange=e=>{ S.detKey=e.target.value||null; refreshProvDet(); refresh(); };
$('#selMetric').onchange=e=>{ S.metricKey=e.target.value||null; refresh(); };
$('#selAgg').onchange=e=>{ S.agg=e.target.value; refresh(); };
$('#chkCmp').onchange=e=>{ S.compare=e.target.value==='1'; refresh(); };
$('#selDayFirst').onchange=e=>{ S.dayFirst=e.target.value==='1'; rebuild(false); };

/* =========================================================================
   Filtro de fechas
   ========================================================================= */
function applyPreset(p,doRefresh=true){
  S.preset=p;
  const now=new Date(); const t=dayStart(now.getTime());
  let from=null,to=null;
  const d=(base,delta)=>{ const x=new Date(base); x.setDate(x.getDate()+delta); return x.getTime(); };
  switch(p){
    case 'today': from=t; to=dayEnd(t); break;
    case 'yesterday': from=d(t,-1); to=dayEnd(d(t,-1)); break;
    case '7': from=d(t,-6); to=dayEnd(t); break;
    case '30': from=d(t,-29); to=dayEnd(t); break;
    case 'tmonth': from=new Date(now.getFullYear(),now.getMonth(),1).getTime(); to=dayEnd(new Date(now.getFullYear(),now.getMonth()+1,0).getTime()); break;
    case 'lmonth': from=new Date(now.getFullYear(),now.getMonth()-1,1).getTime(); to=dayEnd(new Date(now.getFullYear(),now.getMonth(),0).getTime()); break;
    case 'tyear': from=new Date(now.getFullYear(),0,1).getTime(); to=dayEnd(new Date(now.getFullYear(),11,31).getTime()); break;
    case 'lyear': from=new Date(now.getFullYear()-1,0,1).getTime(); to=dayEnd(new Date(now.getFullYear()-1,11,31).getTime()); break;
    case 'all': from=S.min??null; to=S.max!=null?dayEnd(S.max):null; break;
    case 'custom': from=S.from; to=S.to; break;
  }
  S.from=from; S.to=to;
  $('#dFrom').value=from!=null?isoOf(from):'';
  $('#dTo').value=to!=null?isoOf(to):'';
  $$('#presets button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.p===p)));
  if(doRefresh){ refreshProvDet(true); refresh(); }
}
$$('#presets button').forEach(b=>b.onclick=()=>applyPreset(b.dataset.p));
$('#btnAll').onclick=()=>applyPreset('all');
$('#dFrom').onchange=()=>{ S.from=fromISO($('#dFrom').value); S.preset='custom'; $$('#presets button').forEach(b=>b.setAttribute('aria-pressed','false')); refreshProvDet(true); refresh(); };
$('#dTo').onchange=()=>{ const v=fromISO($('#dTo').value); S.to=v!=null?dayEnd(v):null; S.preset='custom'; $$('#presets button').forEach(b=>b.setAttribute('aria-pressed','false')); refreshProvDet(true); refresh(); };

function inRange(t,from,to){
  if(t==null) return from==null&&to==null;
  if(from!=null&&t<from) return false;
  if(to!=null&&t>to) return false;
  return true;
}
function prevWindow(){
  if(S.from==null||S.to==null) return null;
  return {from:S.from-(S.to-S.from)-1, to:S.from-1};
}
function rowsIn(from,to){
  const out=[];
  for(let i=0;i<S.rows.length;i++) if(inRange(S.dateIdx[i],from,to)) out.push(S.rows[i]);
  return out;
}

/* =========================================================================
   Filtro de proveedor / detalle (buscar, multi-selección, todos, limpiar)
   ========================================================================= */
function refreshProvDet(keepCounts){
  ['prov','det'].forEach(kind=>{
    const key = kind==='prov'?S.provKey:S.detKey;
    const allProp = kind==='prov'?'provAll':'detAll';
    const selProp = kind==='prov'?'provSelected':'detSelected';
    if(!key){ S[allProp]=[]; S[selProp]=new Set(); return; }
    const set=new Set();
    for(const r of S.rows) set.add(valOf(r[key]));
    const newAll=Array.from(set).sort((a,b)=>a.localeCompare(b,'es',{numeric:true}));
    const oldAllSet=new Set(S[allProp]);
    const kept=new Set(Array.from(S[selProp]).filter(v=>set.has(v)));
    newAll.forEach(v=>{ if(!oldAllSet.has(v)) kept.add(v); }); // valores nuevos entran seleccionados
    S[allProp]=newAll; S[selProp]=kept;
  });
  renderMultiSelect('prov'); renderMultiSelect('det');
}

function countsForKey(key){
  const rowsInDate = rowsIn(S.from,S.to);
  const map=new Map();
  if(key) for(const r of rowsInDate){ const v=valOf(r[key]); map.set(v,(map.get(v)||0)+1); }
  return map;
}

function renderMultiSelect(kind){
  const key = kind==='prov'?S.provKey:S.detKey;
  const box = $(kind==='prov'?'#provBox':'#detBox');
  const title = kind==='prov'?'Proveedor':'Detalle';
  const allProp = kind==='prov'?'provAll':'detAll';
  const selProp = kind==='prov'?'provSelected':'detSelected';
  const searchProp = kind==='prov'?'provSearch':'detSearch';

  if(!key){
    box.innerHTML='<div class="msel-missing"><strong>'+title+'</strong><br>No se detectó una columna de '+title.toLowerCase()+'. Elígela en Configuración para activar este filtro.</div>';
    return;
  }
  const all=S[allProp], selected=S[selProp];
  const counts=countsForKey(key);
  const needle=(S[searchProp]||'').toLowerCase();
  const visible = needle ? all.filter(v=>v.toLowerCase().includes(needle)) : all;

  box.innerHTML =
    '<div class="msel">'
    + '<div class="msel-head"><strong>'+title+'</strong><span class="msel-count" id="'+kind+'Count">'+selected.size+' de '+all.length+' seleccionados</span></div>'
    + '<input type="search" id="'+kind+'Search" placeholder="Buscar '+title.toLowerCase()+'..." value="'+esc(S[searchProp]||'')+'">'
    + '<div class="msel-actions"><button id="'+kind+'AllBtn">Seleccionar todos</button><button id="'+kind+'ClearBtn">Limpiar</button></div>'
    + '<div class="msel-list" id="'+kind+'List">'
    + (visible.length? visible.map(v=>
        '<label class="msel-item"><input type="checkbox" data-v="'+esc(v)+'"'+(selected.has(v)?' checked':'')+'>'
        + '<span class="nm">'+esc(v)+'</span><span class="ct">'+fmtInt(counts.get(v)||0)+'</span></label>'
      ).join('') : '<div class="msel-empty">Sin coincidencias para "'+esc(S[searchProp]||'')+'"</div>')
    + '</div>'
    + (selected.size===0 ? '<div class="msel-warn">Sin '+title.toLowerCase()+'es seleccionados: no se mostrará ningún registro.</div>' : '')
    + '</div>';

  $('#'+kind+'Search').oninput = e=>{ S[searchProp]=e.target.value; renderMultiSelect(kind); };
  $('#'+kind+'AllBtn').onclick = ()=>{ S[selProp]=new Set(all); renderMultiSelect(kind); refresh(); };
  $('#'+kind+'ClearBtn').onclick = ()=>{ S[selProp]=new Set(); renderMultiSelect(kind); refresh(); };
  box.querySelectorAll('[data-v]').forEach(chk=>{
    chk.onchange=()=>{
      const v=chk.dataset.v;
      if(chk.checked) selected.add(v); else selected.delete(v);
      $('#'+kind+'Count').textContent=selected.size+' de '+all.length+' seleccionados';
      const warnHost=box.querySelector('.msel');
      let warn=warnHost.querySelector('.msel-warn');
      if(selected.size===0 && !warn){ warn=document.createElement('div'); warn.className='msel-warn';
        warn.textContent='Sin '+title.toLowerCase()+'es seleccionados: no se mostrará ningún registro.'; warnHost.appendChild(warn); }
      if(selected.size>0 && warn) warn.remove();
      refresh();
    };
  });
}

function matchesProvDet(row){
  if(S.provKey && !S.provSelected.has(valOf(row[S.provKey]))) return false;
  if(S.detKey && !S.detSelected.has(valOf(row[S.detKey]))) return false;
  return true;
}

/* =========================================================================
   Cálculo de indicadores
   ========================================================================= */
function stats(rows){
  const k=S.metricKey;
  let sum=0,n=0,min=Infinity,max=-Infinity;
  if(k) for(const r of rows){ const v=parseNumber(r[k]); if(v!==null){ sum+=v;n++; if(v<min)min=v; if(v>max)max=v; } }
  const provs=new Set(), dets=new Set();
  if(S.provKey) for(const r of rows) provs.add(valOf(r[S.provKey]));
  if(S.detKey) for(const r of rows) dets.add(valOf(r[S.detKey]));
  return {count:rows.length, ops:k?n:rows.length, sum:k?sum:rows.length, avg:n?sum/n:null,
          min:n?min:null, max:n?max:null, proveedores:provs.size, detalles:dets.size};
}
function delta(cur,prev){
  if(prev==null||!isFinite(prev)||prev===0) return {abs:cur!=null?cur-(prev||0):null,pct:null};
  return {abs:cur-prev, pct:(cur-prev)/Math.abs(prev)*100};
}
function deltaHtml(d){
  if(d.pct==null) return '<span class="flat">sin base de comparación</span>';
  const cls=d.pct>0.05?'up':d.pct<-0.05?'down':'flat';
  const ar=d.pct>0.05?'↑':d.pct<-0.05?'↓':'=';
  return '<span class="'+cls+'">'+ar+' '+fmtN(Math.abs(d.pct))+'%</span><span>('+(d.abs>=0?'+':'−')+fmtN(Math.abs(d.abs))+')</span>';
}

/* =========================================================================
   Render principal
   ========================================================================= */
function refresh(){
  if(!S.rows.length) return;
  const inRangeRows = rowsIn(S.from,S.to);
  S.filtered = inRangeRows.filter(matchesProvDet);

  const label = (S.from==null&&S.to==null) ? 'todo el historial'
    : (S.from!=null?fmtDate(S.from):'inicio')+' → '+(S.to!=null?fmtDate(S.to):'hoy');
  $('#rangeChip').innerHTML='Periodo: <b>'+label+'</b>';
  $('#kpiHint').textContent=fmtInt(S.filtered.length)+' de '+fmtInt(S.rows.length)+' registros totales';
  $('#repLine').innerHTML='El reporte saldrá con el periodo <b>'+label+'</b>, '+fmtInt(S.filtered.length)+' registros y las columnas visibles de la tabla.';

  renderKpis(); renderPivot(); S.page=1; renderTable();
}

function renderKpis(){
  const cur=stats(S.filtered);
  const pw=S.compare?prevWindow():null;
  const prev=pw?stats(rowsIn(pw.from,pw.to).filter(matchesProvDet)):null;
  const mLabel=S.metricKey?(S.cols.find(c=>c.key===S.metricKey)||{}).label:'—';
  const cards=[
    ['Registros', fmtInt(cur.count), prev?delta(cur.count,prev.count):null, true],
    ['Proveedores', S.provKey?fmtInt(cur.proveedores):'—', prev&&S.provKey?delta(cur.proveedores,prev.proveedores):null, true],
    ['Detalles distintos', S.detKey?fmtInt(cur.detalles):'—', prev&&S.detKey?delta(cur.detalles,prev.detalles):null, true],
    ['Operaciones con '+(S.metricKey?esc(mLabel):'dato'), fmtInt(cur.ops), prev?delta(cur.ops,prev.ops):null, true],
    ['Suma de '+esc(mLabel), S.metricKey?fmtN(cur.sum):'—', prev&&S.metricKey?delta(cur.sum,prev.sum):null, false],
    ['Promedio', cur.avg!=null?fmtN(cur.avg):'—', prev&&cur.avg!=null?delta(cur.avg,prev.avg):null, false],
    ['Mínimo', cur.min!=null?fmtN(cur.min):'—', null, false],
    ['Máximo', cur.max!=null?fmtN(cur.max):'—', null, false]
  ];
  $('#kpis').innerHTML=cards.map(([k,v,d])=>
    '<div class="kpi"><div class="k">'+k+'</div><div class="v num">'+v+'</div>'
    + '<div class="d">'+(d?deltaHtml(d)+'<span>vs. periodo anterior</span>':'<span>en el periodo</span>')+'</div></div>'
  ).join('');
}

/* ---- Proveedor x Detalle ---- */
function renderPivot(){
  const missing = !S.provKey || !S.detKey;
  $('#pivotMissing').classList.toggle('hidden',!missing);
  $('#pivotTable').classList.toggle('hidden',missing);
  $('#pivotSearch').closest('.pivot-tools').classList.toggle('hidden',missing);
  if(missing){ $('#pivotTable').innerHTML=''; return; }

  const mLabel=S.metricKey?(S.cols.find(c=>c.key===S.metricKey)||{}).label:null;
  const measureLabel = S.agg==='count' ? 'Registros' : (S.agg==='avg'?'Promedio de '+(mLabel||'—'):'Suma de '+(mLabel||'—'));
  $('#pivotHint').textContent = 'Registros y '+measureLabel.toLowerCase()+' por combinación, con todos los filtros aplicados';

  const map=new Map(); // key: prov\u0001det
  for(const r of S.filtered){
    const p=valOf(r[S.provKey]), d=valOf(r[S.detKey]);
    const key=p+'\u0001'+d;
    const o=map.get(key)||{prov:p,det:d,count:0,sum:0,n:0};
    o.count++;
    if(S.metricKey){ const v=parseNumber(r[S.metricKey]); if(v!==null){ o.sum+=v; o.n++; } }
    map.set(key,o);
  }
  let arr=Array.from(map.values()).map(o=>({
    prov:o.prov, det:o.det, registros:o.count,
    metrica: S.agg==='count' ? o.count : (S.agg==='avg' ? (o.n?o.sum/o.n:0) : o.sum)
  }));

  const needle=(S.pivotSearch||'').toLowerCase();
  if(needle) arr=arr.filter(r=>r.prov.toLowerCase().includes(needle)||r.det.toLowerCase().includes(needle));

  const {key,dir}=S.pivotSort;
  arr.sort((a,b)=>{
    if(key==='prov'||key==='det') return a[key].localeCompare(b[key],'es',{numeric:true})*dir;
    return (a[key]-b[key])*dir;
  });

  const totalRegistros=arr.reduce((a,r)=>a+r.registros,0);
  const totalMetrica=arr.reduce((a,r)=>a+r.metrica,0);

  const sortIcon=k=>S.pivotSort.key===k?('<span class="sortmark">'+(S.pivotSort.dir>0?'▲':'▼')+'</span>'):'';
  $('#pivotTable').innerHTML =
    '<thead><tr>'
    + '<th data-s="prov">Proveedor'+sortIcon('prov')+'</th>'
    + '<th data-s="det">Detalle'+sortIcon('det')+'</th>'
    + '<th data-s="registros">Registros'+sortIcon('registros')+'</th>'
    + '<th data-s="metrica">'+esc(measureLabel)+sortIcon('metrica')+'</th>'
    + '</tr></thead>'
    + '<tbody>'+ (arr.length? arr.map(r=>
        '<tr><td>'+esc(r.prov)+'</td><td>'+esc(r.det)+'</td><td class="n">'+fmtInt(r.registros)+'</td><td class="n">'+fmtN(r.metrica)+'</td></tr>'
      ).join('') : '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px">No hay combinaciones para el periodo y los filtros actuales.</td></tr>') + '</tbody>'
    + '<tfoot><tr><td colspan="2">Total ('+arr.length+' combinaciones)</td><td class="n">'+fmtInt(totalRegistros)+'</td><td class="n">'+fmtN(totalMetrica)+'</td></tr></tfoot>';

  $('#pivotTable').querySelectorAll('[data-s]').forEach(th=>th.onclick=()=>{
    const k=th.dataset.s;
    if(S.pivotSort.key===k) S.pivotSort.dir*=-1; else S.pivotSort={key:k,dir:k==='registros'||k==='metrica'?-1:1};
    renderPivot();
  });
}
$('#pivotSearch').oninput=e=>{ S.pivotSearch=e.target.value; renderPivot(); };

