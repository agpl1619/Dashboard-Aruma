    ['Registros en el reporte',tblCache.length],
    ['Columna de fecha',(S.cols.find(c=>c.key===S.dateKey)||{}).label||'—'],
    ['Columna de proveedor',(S.cols.find(c=>c.key===S.provKey)||{}).label||'—'],
    ['Columna de detalle',(S.cols.find(c=>c.key===S.detKey)||{}).label||'—'],
    ['Métrica',(S.cols.find(c=>c.key===S.metricKey)||{}).label||'conteo'],
    ['Filtros aplicados',filterSummary().join(' · ')||'sólo el periodo'],
    ['Archivos',S.files.filter(f=>f.status==='listo').map(f=>f.name).join(', ')],[]];
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(meta.concat(kpiMatrix())),'Resumen');
  XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(pivotMatrix()),'Proveedor-Detalle');
  const data=exportRows();
  const ws=XLSX.utils.json_to_sheet(data.length?data:[{Aviso:'Sin registros en el periodo y filtros'}]);
  ws['!cols']=Object.keys(data[0]||{Aviso:1}).map(k=>({wch:Math.min(38,Math.max(11,k.length+4))}));
  XLSX.utils.book_append_sheet(wb,ws,'Datos');
  XLSX.writeFile(wb,'cronograma-proveedores-'+stamp()+'.xlsx');
  toast('Excel descargado con '+fmtInt(tblCache.length)+' registros.');
}
function exportCsv(){
  const data=exportRows();
  const ws=XLSX.utils.json_to_sheet(data.length?data:[{Aviso:'Sin registros'}]);
  const csv=XLSX.utils.sheet_to_csv(ws,{FS:';'});
  const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='cronograma-proveedores-'+stamp()+'.csv'; a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),2000);
  toast('CSV descargado.');
}
function exportPdf(){
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({orientation:'landscape',unit:'pt',format:'a4'});
  doc.setFillColor(250,0,130); doc.rect(0,0,doc.internal.pageSize.getWidth(),46,'F');
  doc.setTextColor(255,255,255); doc.setFont('helvetica','bold'); doc.setFontSize(15);
  doc.text('Cronograma de Proveedores Aruma',40,30);
  doc.setTextColor(60,45,52); doc.setFont('helvetica','normal'); doc.setFontSize(9.5);
  doc.text('Periodo: '+rangeLabel()+'   ·   '+fmtInt(tblCache.length)+' registros   ·   generado '+new Date().toLocaleString('es-PE'),40,62);
  doc.text('Filtros: '+(filterSummary().join('  ·  ')||'sólo el periodo'),40,76);
  doc.autoTable({startY:88,head:[kpiMatrix()[0]],body:kpiMatrix().slice(1),
    theme:'grid',styles:{fontSize:8.5,cellPadding:4},
    headStyles:{fillColor:[250,0,130],textColor:255},margin:{left:40,right:40}});
  doc.autoTable({startY:doc.lastAutoTable.finalY+16,head:[pivotMatrix()[0]],body:pivotMatrix().slice(1),
    theme:'striped',styles:{fontSize:8,cellPadding:3.5},
    headStyles:{fillColor:[131,130,247],textColor:255},margin:{left:40,right:40}});
  const cols=visibleCols(); const limit=3000;
  const body=tblCache.slice(0,limit).map(r=>cols.map(c=>cellText(r,c)));
  doc.addPage('a4','landscape');
  doc.autoTable({startY:40,head:[cols.map(c=>c.label)],body,
    theme:'striped',styles:{fontSize:7.2,cellPadding:2.6,overflow:'ellipsize'},
    headStyles:{fillColor:[36,28,34],textColor:255},margin:{left:40,right:40}});
  if(tblCache.length>limit) doc.text('Se incluyeron los primeros '+fmtInt(limit)+' registros. Usa Excel o CSV para el detalle completo.',40,doc.lastAutoTable.finalY+16);
  doc.save('cronograma-proveedores-'+stamp()+'.pdf');
  toast('PDF descargado.');
}
$('#btnXlsx').onclick=exportXlsx; $('#btnXlsxT').onclick=exportXlsx;
$('#btnCsv').onclick=exportCsv;   $('#btnCsvT').onclick=exportCsv;
$('#btnPdf').onclick=exportPdf;
$('#btnPrint').onclick=()=>window.print();
$('#btnReport').onclick=()=>{ $('#sec-reporte').scrollIntoView({behavior:'smooth'}); };

/* navegación del rail */
$$('.rail button').forEach(b=>b.onclick=()=>{
  const el=$('#'+b.dataset.go); if(!el||el.classList.contains('hidden')) return toast('Carga archivos para ver esta sección.');
  el.scrollIntoView({behavior:'smooth'});
  $$('.rail button').forEach(x=>x.setAttribute('aria-current','false'));
  b.setAttribute('aria-current','true');
});
const spy=new IntersectionObserver(es=>{
  es.forEach(e=>{ if(e.isIntersecting){
    $$('.rail button').forEach(x=>x.setAttribute('aria-current',String(x.dataset.go===e.target.id))); } });
},{rootMargin:'-40% 0px -55% 0px'});
$$('section').forEach(s=>spy.observe(s));
</script>
