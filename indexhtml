$('#pgLast').onclick=()=>{ S.page=1e9; renderTable(); };

function tableRows(){
  const cols=visibleCols();
  let out=S.filtered;
  const cf=Object.entries(S.colFilters).filter(([k,v])=>v);
  if(cf.length) out=out.filter(r=>cf.every(([k,v])=>String(r[k]??'').toLowerCase().includes(v)));
  if(S.q) out=out.filter(r=>cols.some(c=>String(r[c.key]??'').toLowerCase().includes(S.q)));
  if(S.sortKey){
    const col=S.cols.find(c=>c.key===S.sortKey)||{};
    out=out.slice().sort((a,b)=>{
      let x=a[S.sortKey], y=b[S.sortKey];
      if(col.type==='number'){ x=parseNumber(x); y=parseNumber(y); }
      else if(col.type==='date'){ x=parseDate(x,S.dayFirst); y=parseDate(y,S.dayFirst); }
      if(x==null&&y==null) return 0; if(x==null) return 1; if(y==null) return -1;
      if(typeof x==='number'&&typeof y==='number') return (x-y)*S.sortDir;
      return String(x).localeCompare(String(y),'es',{numeric:true})*S.sortDir;
    });
  }
  return out;
}
function cellText(r,c){
  const v=r[c.key];
  if(v==null||v==='') return '';
  if(c.type==='date'){ const t=parseDate(v,S.dayFirst); return t!=null?fmtDate(t):String(v); }
  if(c.type==='number'){ const n=parseNumber(v); return n!==null?fmtN(n):String(v); }
  return String(v);
}
let tblCache=[];
function renderTable(){
  const cols=visibleCols();
  const rows=tableRows(); tblCache=rows;
  const pages=Math.max(1,Math.ceil(rows.length/S.pageSize));
  S.page=Math.min(Math.max(1,S.page),pages);
  const start=(S.page-1)*S.pageSize, slice=rows.slice(start,start+S.pageSize);

  $('#tbl').tHead.innerHTML='<tr>'+cols.map(c=>{
    const mark=S.sortKey===c.key?'<span class="sortmark">'+(S.sortDir>0?'▲':'▼')+'</span>':'';
    return '<th><div class="thin" data-sort="'+c.key+'">'+esc(c.label)+mark+'</div>'
      +'<input data-f="'+c.key+'" placeholder="filtrar" value="'+esc(S.colFilters[c.key]||'')+'"></th>';
  }).join('')+'</tr>';
  $('#tbl').tBodies[0].innerHTML=slice.map(r=>'<tr>'+cols.map(c=>
    '<td'+(c.type==='number'?' class="n"':'')+'>'+esc(cellText(r,c))+'</td>').join('')+'</tr>').join('');

  $('#tbl').querySelectorAll('[data-sort]').forEach(h=>h.onclick=()=>{
    const k=h.dataset.sort;
    if(S.sortKey===k) S.sortDir*=-1; else { S.sortKey=k; S.sortDir=1; }
    renderTable();
  });
  $('#tbl').querySelectorAll('[data-f]').forEach(inp=>{
    inp.oninput=()=>{ S.colFilters[inp.dataset.f]=inp.value.toLowerCase().trim(); S.page=1;
      const k=inp.dataset.f, pos=inp.selectionStart; renderTable();
      const again=document.querySelector('[data-f="'+k+'"]'); if(again){ again.focus(); again.setSelectionRange(pos,pos); } };
  });
  $('#tblCount').textContent=fmtInt(rows.length)+' filas'+(rows.length!==S.filtered.length?' (de '+fmtInt(S.filtered.length)+' en el periodo y filtros)':'');
  $('#pgInfo').textContent='Página '+S.page+' de '+pages+' · filas '+(rows.length?fmtInt(start+1):0)+'–'+fmtInt(Math.min(start+S.pageSize,rows.length));
  $('#pgFirst').disabled=$('#pgPrev').disabled=S.page===1;
  $('#pgNext').disabled=$('#pgLast').disabled=S.page===pages;
}

