function kpiMatrix(){
  const cur=stats(S.filtered);
  const pw=S.compare?prevWindow():null;
  const prev=pw?stats(rowsIn(pw.from,pw.to).filter(matchesProvDet)):null;
  const rows=[['Indicador','Actual','Anterior','Diferencia','Variación %']];
  const add=(n,a,b)=>{ const d=prev?delta(a,b):{abs:null,pct:null};
    rows.push([n, a==null?'':+(+a).toFixed(4), b==null?'':+(+b).toFixed(4),
      d.abs==null?'':+d.abs.toFixed(4), d.pct==null?'':+d.pct.toFixed(2)]); };
  add('Registros',cur.count,prev?prev.count:null);
  add('Proveedores',cur.proveedores,prev?prev.proveedores:null);
  add('Detalles distintos',cur.detalles,prev?prev.detalles:null);
  add('Operaciones',cur.ops,prev?prev.ops:null);
  add('Suma',cur.sum,prev?prev.sum:null);
  add('Promedio',cur.avg,prev?prev.avg:null);
  add('Mínimo',cur.min,prev?prev.min:null);
  add('Máximo',cur.max,prev?prev.max:null);
  return rows;
}

function pivotMatrix(){
  if(!S.provKey||!S.detKey) return [['Proveedor','Detalle','Registros','Métrica'],['Configura columna de proveedor y detalle para ver esta tabla.','','','']];
  const mLabel=S.metricKey?(S.cols.find(c=>c.key===S.metricKey)||{}).label:null;
  const measureLabel = S.agg==='count' ? 'Registros' : (S.agg==='avg'?'Promedio de '+(mLabel||'—'):'Suma de '+(mLabel||'—'));
  const map=new Map();
  for(const r of S.filtered){
    const p=valOf(r[S.provKey]), d=valOf(r[S.detKey]);
    const key=p+'\u0001'+d;
    const o=map.get(key)||{prov:p,det:d,count:0,sum:0,n:0};
    o.count++;
    if(S.metricKey){ const v=parseNumber(r[S.metricKey]); if(v!==null){ o.sum+=v; o.n++; } }
    map.set(key,o);
  }
  const rows=[['Proveedor','Detalle','Registros',measureLabel]];
  Array.from(map.values())
    .map(o=>({prov:o.prov,det:o.det,registros:o.count,metrica: S.agg==='count'?o.count:(S.agg==='avg'?(o.n?o.sum/o.n:0):o.sum)}))
    .sort((a,b)=>b.registros-a.registros)
    .forEach(o=>rows.push([o.prov,o.det,o.registros,+o.metrica.toFixed(4)]));
  return rows;
}

